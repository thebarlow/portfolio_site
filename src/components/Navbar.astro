---
const navLinks = [
  { label: "About", href: "/#about" },
  { label: "Projects", href: "/#projects" },
  { label: "Contact", href: "/#contact" },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/85 dark:bg-zinc-950/85 backdrop-blur-md border-b border-zinc-200 dark:border-zinc-800"
>
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="hover:opacity-70 transition-opacity" aria-label="Home">
      <img
        src="/logo.svg"
        alt="Matthew Barlow"
        class="h-8 w-auto"
      />
    </a>

    <!-- Nav links + theme toggle -->
    <div class="flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors"
        >
          {link.label}
        </a>
      ))}

      <!-- Dark/light toggle -->
      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="w-9 h-9 flex items-center justify-center rounded-full text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("theme-toggle");
  const html = document.documentElement;
  const sun = document.getElementById("icon-sun");
  const moon = document.getElementById("icon-moon");

  // Apply saved theme on load
  if (localStorage.theme === "dark") {
    html.classList.add("dark");
    sun?.classList.remove("hidden");
    moon?.classList.add("hidden");
  }

  toggle?.addEventListener("click", () => {
    const isDark = html.classList.toggle("dark");
    localStorage.theme = isDark ? "dark" : "light";
    sun?.classList.toggle("hidden", !isDark);
    moon?.classList.toggle("hidden", isDark);
  });
</script>
