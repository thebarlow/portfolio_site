---
import Layout from "./Layout.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <article class="max-w-3xl mx-auto px-6 py-20 prose-project">
    <slot />
  </article>
</Layout>

<style>
  /* Headings */
  :global(.prose-project h1) {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 1rem;
    color: var(--color-zinc-900);
  }
  :global(.dark .prose-project h1) { color: #ffffff; }

  :global(.prose-project h2) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-zinc-900);
  }
  :global(.dark .prose-project h2) { color: #ffffff; }

  :global(.prose-project h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--color-zinc-800);
  }
  :global(.dark .prose-project h3) { color: var(--color-zinc-100); }

  /* Body text */
  :global(.prose-project) {
    color: var(--color-zinc-800);
  }
  :global(.dark .prose-project) {
    color: var(--color-zinc-100);
  }
  :global(.prose-project p) {
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  /* Horizontal rule */
  :global(.prose-project hr) {
    border-color: var(--color-zinc-200);
    margin: 2rem 0;
  }
  :global(.dark .prose-project hr) { border-color: var(--color-zinc-800); }

  /* Links */
  :global(.prose-project a) {
    color: var(--color-cyan-500);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.prose-project a:hover) { color: var(--color-cyan-400); }

  /* Inline code */
  :global(.prose-project code) {
    background: var(--color-zinc-100);
    color: var(--color-zinc-800);
    font-size: 0.875em;
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    font-family: ui-monospace, monospace;
  }
  :global(.dark .prose-project code) {
    background: var(--color-zinc-800);
    color: var(--color-zinc-100);
  }

  /* Code blocks */
  :global(.prose-project pre) {
    background: var(--color-zinc-900);
    color: var(--color-zinc-100);
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  :global(.prose-project pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
  }

  /* Lists */
  :global(.prose-project ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  :global(.prose-project ol) {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  :global(.prose-project li) { margin-bottom: 0.35rem; }

  /* Blockquote */
  :global(.prose-project blockquote) {
    border-left: 3px solid var(--color-cyan-500);
    padding-left: 1rem;
    color: var(--color-zinc-500);
    font-style: italic;
    margin: 1.5rem 0;
  }

  /* Media */
  :global(.prose-project img),
  :global(.prose-project video),
  :global(.prose-project iframe) {
    max-width: 100%;
    border-radius: 0.75rem;
    margin: 1.5rem auto;
    display: block;
  }
</style>
