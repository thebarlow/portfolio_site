---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const href = project.slug ? `/projects/${project.slug}/overview` : (project.url ?? project.github ?? "#");
const external = !project.slug;
const visibleTech = project.tech.slice(0, 3);
const hiddenCount = project.tech.length - 3;
const imgFit = project.thumbnailFit === "contain" ? "object-contain p-8" : "object-cover";
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="card-trace project-card group relative rounded-2xl cursor-pointer overflow-hidden block"
  style="aspect-ratio:3/4;"
>
  <!-- Inner clipping layer -->
  <div class="absolute inset-0 rounded-2xl overflow-hidden" style="z-index:1;">

    <!-- Thumbnail -->
    <img
      src={project.thumbnail ?? "/tavernboard-icon.svg"}
      alt={project.title}
      class={`absolute inset-0 w-full h-full ${imgFit}`}
    />

    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>

    <!-- Content pinned to bottom -->
    <div class="absolute bottom-0 left-0 right-0 p-4 flex flex-col gap-2">
      <h3 class="font-semibold text-white group-hover:text-cyan-400 transition-colors">
        {project.title}
      </h3>

      <!-- Description: slides in on hover -->
      <p class="text-sm text-zinc-300 leading-snug line-clamp-2 max-h-0 overflow-hidden opacity-0 group-hover:max-h-20 group-hover:opacity-100 transition-all duration-300">
        {project.description}
      </p>

      <!-- Tags: idle shows first 3 + count -->
      <div class="flex gap-1 flex-wrap group-hover:hidden">
        {visibleTech.map((t) => (
          <span class="px-2 py-0.5 rounded-md bg-white/10 text-zinc-300 text-xs font-mono">{t}</span>
        ))}
        {hiddenCount > 0 && (
          <span class="px-2 py-0.5 rounded-md bg-white/10 text-zinc-300 text-xs font-mono">+{hiddenCount}</span>
        )}
      </div>

      <!-- Tags: hover shows all -->
      <div class="hidden gap-1 flex-wrap group-hover:flex">
        {project.tech.map((t) => (
          <span class="px-2 py-0.5 rounded-md bg-white/10 text-zinc-300 text-xs font-mono">{t}</span>
        ))}
      </div>
    </div>
  </div>
</a>

<style>
  .card-trace {
    position: relative;
    border: 1px solid rgba(255,255,255,0.08) !important;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .card-trace::before {
    content: '';
    position: absolute;
    inset: -1.5px;
    border-radius: inherit;
    background: conic-gradient(from var(--angle, 0deg), transparent 0%, transparent 60%, #22d3ee 80%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
    pointer-events: none;
  }

  .card-trace:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.5), 0 0 30px rgba(34,211,238,0.1);
  }

  .card-trace:hover::before {
    opacity: 1;
  }
</style>

<script>
  if (window.self === window.top) {
    // Border trace animation
    const cards = document.querySelectorAll<HTMLElement>(".card-trace");
    const angles = new Map<Element, number>();

    function animateBorder() {
      cards.forEach((card) => {
        if (card.matches(":hover")) {
          const current = angles.get(card) ?? 0;
          const next = (current + 1.5) % 360;
          angles.set(card, next);
          card.style.setProperty("--angle", `${next}deg`);
        }
      });
      requestAnimationFrame(animateBorder);
    }
    animateBorder();

  }
</script>
